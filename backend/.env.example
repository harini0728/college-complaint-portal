# Copy this file to `.env` and fill in the values. Never commit `.env`.

NODE_ENV=development
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/college-complaint-portal
# MongoDB Atlas (example):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college-complaint-portal?retryWrites=true&w=majority

# At least 32 characters. Generate one with:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API (comma-separated). Vite's default is 5173.
CLIENT_URL=http://localhost:5173

# Only used by `npm run seed:admin` (creates the first admin account)
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=
